---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Leaderboard from '../../components/coliseum/Leaderboard.svelte';
import 'katex/dist/katex.min.css';
import '../../styles/global.css';

const challenges = await getCollection('coliseum', ({ data }) => data.isActive);

const challengeList = challenges.map((c) => ({
  id: c.id,
  title: c.data.title,
  metricLabel: c.data.metricLabel
}));
---

<Layout title="walkerMath\coliseum">
  <main class="py-12 space-y-8 font-mono">
    <header class="border-b border-[var(--border-color)] pb-6 flex justify-between items-end">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">walkerMath\coliseum</h1>
        <p class="text-xs text-[var(--text-muted)] mt-1">// competitive interactive challenges</p>
      </div>
      <a href="/" class="text-xs text-[var(--text-muted)] hover:text-[var(--accent)]">&lt;- [home]</a>
    </header>

    <!-- Terminal-Style Tab Switcher -->
    <nav class="flex items-center gap-3 border-b border-[var(--border-color)] pb-4 text-xs">
      <button
        data-tab-target="challenges"
        class="tab-btn px-3 py-1.5 rounded border border-[var(--accent)] text-[var(--accent)] bg-[var(--bg-surface)] font-bold transition-colors cursor-pointer"
      >
        [challenges ({challenges.length})]
      </button>
      <button
        data-tab-target="leaderboards"
        class="tab-btn px-3 py-1.5 rounded border border-[var(--border-color)] text-[var(--text-muted)] bg-[var(--bg-surface)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors cursor-pointer"
      >
        [leaderboards]
      </button>
    </nav>

    <!-- ========================================== -->
    <!-- TAB 1: CHALLENGES                          -->
    <!-- ========================================== -->
    <section id="tab-panel-challenges" class="space-y-4">
      {challenges.length === 0 ? (
        <div class="p-6 border border-[var(--border-color)] bg-[var(--bg-surface)] rounded-md text-sm text-[var(--text-muted)]">
          <p>[!] No active challenges found in src/content/coliseum/.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {challenges.map((entry) => (
            <a 
              href={`/coliseum/${entry.id}`}
              class="group flex flex-col justify-between p-5 border border-[var(--border-color)] bg-[var(--bg-surface)] rounded-md hover:border-[var(--accent)] transition-colors"
            >
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs text-[var(--text-muted)]">
                  <span>// {entry.data.topic}</span>
                  <span>metric: {entry.data.metricLabel}</span>
                </div>

                <h2 class="text-lg font-bold group-hover:text-[var(--accent)] transition-colors">
                  {entry.data.title}
                </h2>
                
                <p class="text-xs text-[var(--text-muted)] leading-relaxed">
                  {entry.data.description}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t border-[var(--border-color)] flex items-center justify-between text-xs">
                <span class="text-[var(--text-muted)]">id: {entry.id}</span>
                <span class="text-[var(--text-muted)] group-hover:text-[var(--accent)] font-bold">
                  [launch] &gt;
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- ========================================== -->
    <!-- TAB 2: LEADERBOARDS                        -->
    <!-- ========================================== -->
    <section id="tab-panel-leaderboards" class="hidden">
      <Leaderboard client:load/>
    </section>

    <footer class="pt-8 border-t border-[var(--border-color)] flex justify-between items-center text-xs text-[var(--text-muted)]">
      <span><a href="/">walkermath.com</a></span>
      <a 
        href="/contact" 
        class="border border-[var(--border-color)] bg-[var(--bg-surface)] px-3 py-1.5 rounded hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors font-bold"
      >
        [contact]
      </a>
    </footer>
  </main>

  <script>
    function initColiseumTabs() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
      const panelChallenges = document.getElementById('tab-panel-challenges');
      const panelLeaderboards = document.getElementById('tab-panel-leaderboards');

      function setActiveTab(tabName: string) {
        const isLeaderboards = tabName === 'leaderboards';

        panelChallenges?.classList.toggle('hidden', isLeaderboards);
        panelLeaderboards?.classList.toggle('hidden', !isLeaderboards);

        buttons.forEach((btn) => {
          const active = btn.dataset.tabTarget === tabName;
          btn.classList.toggle('border-[var(--accent)]', active);
          btn.classList.toggle('text-[var(--accent)]', active);
          btn.classList.toggle('font-bold', active);
          btn.classList.toggle('border-[var(--border-color)]', !active);
          btn.classList.toggle('text-[var(--text-muted)]', !active);
        });
      }

      if (window.location.hash === '#leaderboards') {
        setActiveTab('leaderboards');
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.dataset.tabTarget || 'challenges';
          setActiveTab(target);
          history.replaceState(null, '', target === 'leaderboards' ? '#leaderboards' : '/coliseum');
        });
      });
    }

    initColiseumTabs();
    document.addEventListener('astro:after-swap', initColiseumTabs);
  </script>
</Layout>