---
import Layout from '../../layouts/Layout.astro';
import 'katex/dist/katex.min.css';
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const allApps = await getCollection('apps');
---

<Layout title="walkerMath\\apps">
  <main class="py-12 space-y-8 font-mono">
    <header class="border-b border-[var(--border-color)] pb-6 flex justify-between items-end">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">walkerMath\apps</h1>
        <p class="text-xs text-[var(--text-muted)] mt-1">// Interactive math tools and simulations</p>
      </div>
      <a href="/" class="text-xs text-[var(--text-muted)] hover:text-[var(--accent)]">&lt;- [home]</a>
    </header>

    <section class="space-y-4">
      {allApps.length === 0 ? (
        <div class="p-6 border border-[var(--border-color)] bg-[var(--bg-surface)] rounded-md text-sm text-[var(--text-muted)]">
          <p>[!] No apps found in directory.</p>
        </div>
      ) : (
        allApps.map((app) => {
            const cleanId = app.id.replace(/\.mdx?$/, '');
            return (
                <a 
                    href={`/apps/${cleanId}`} 
                    class="block p-6 border border-[var(--border-color)] bg-[var(--bg-surface)] hover:border-[var(--accent)] transition-colors rounded-md group"
                >
                    <div class="flex justify-between items-start mb-2">
                    <h2 class="text-lg font-bold group-hover:text-[var(--accent)]">[{app.data.title}]</h2>
                    <span class="text-xs text-[var(--text-muted)]">// {app.data.category}</span>
                    </div>
                    <p class="text-xs text-[var(--text-muted)]">{app.data.description}</p>
            </a>
            );
        })
      )}
    </section>

    <footer class="pt-8 border-t border-[var(--border-color)] flex justify-between items-center text-xs text-[var(--text-muted)]">
      <span><a href="/">walkermath.com</a></span>
      <a 
        href="/contact" 
        class="border border-[var(--border-color)] bg-[var(--bg-surface)] px-3 py-1.5 rounded hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors font-bold"
      >
        [contact]
      </a>
    </footer>
  </main>
</Layout>