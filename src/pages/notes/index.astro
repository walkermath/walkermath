---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import 'katex/dist/katex.min.css';
import '../../styles/global.css';

const allNotes = await getCollection('notes');
---

<Layout title="walkerMath\\notes">
  <main class="py-12 space-y-8 font-mono">
    <header class="border-b border-[var(--border-color)] pb-6 flex justify-between items-end">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">walkerMath\notes</h1>
        <p class="text-xs text-[var(--text-muted)] mt-1">// Course materials, statistical theory, & formulas</p>
      </div>
      <a href="/" class="text-xs text-[var(--text-muted)] hover:text-[var(--accent)]">[<- home]</a>
    </header>

    <section class="space-y-4">
      {allNotes.length === 0 ? (
        <div class="p-6 border border-[var(--border-color)] bg-[var(--bg-surface)] rounded-md text-sm text-[var(--text-muted)]">
          <p>[!] No published notes found in directory.</p>
        </div>
      ) : (
        allNotes.map((note) => {
            const cleanId = note.id.replace(/\.mdx?$/, '');
            return (
                <a 
                    href={`/notes/${note.id}`} 
                    class="block p-6 border border-[var(--border-color)] bg-[var(--bg-surface)] hover:border-[var(--accent)] transition-colors rounded-md group"
                >
                    <div class="flex justify-between items-start mb-2">
                    <h2 class="text-lg font-bold group-hover:text-[var(--accent)]">[{note.data.title}]</h2>
                    <span class="text-xs text-[var(--text-muted)]">// {note.data.category}</span>
                    </div>
                    <p class="text-xs text-[var(--text-muted)]">{note.data.description}</p>
            </a>
            );
        })
      )}
    </section>

    <footer class="pt-8 border-t border-[var(--border-color)] flex justify-between items-center text-xs text-[var(--text-muted)]">
      <span>walkermath.com</span>
      <a 
        href="/contact" 
        class="border border-[var(--border-color)] bg-[var(--bg-surface)] px-3 py-1.5 rounded hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors font-bold"
      >
        [contact]
      </a>
    </footer>
  </main>
</Layout>