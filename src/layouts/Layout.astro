---
import FloatingNav from '../components/FloatingNav.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  /** Wider page for tools like the lesson builder. */
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class:list={['min-h-screen p-6 md:p-12 mx-auto', wide ? 'max-w-6xl' : 'max-w-4xl']}>
    <FloatingNav />
    <slot />
  </body>
</html>